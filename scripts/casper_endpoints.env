# ═══════════════════════════════════════════════════════════════════════════════
# casper_endpoints.env — Casper の外部依存先を一箇所に集めた設定（殿御下命 2026-08-03）
# ───────────────────────────────────────────────────────────────────────────────
# z8a(推論機)の移設に備え、散っていた宛先をここへ集約した。
# 移す時はこのファイルの値だけを書き換える。コードは触らぬ。
#
# 読み込み方: supervisor / keepalive が起動時に source する。
#             手で叩く時は  set -a; . casper_endpoints.env; set +a
# ═══════════════════════════════════════════════════════════════════════════════

# ── ① 推論(qwen)= z8a ─ 移設の主対象 ──────────────────────────────────
# 要件: VRAM 18GB以上(qwen3.6:27b が 17.3GB を常駐占有)。16GBでは載らず 14b へ落ちる。
#       keep_alive=-1 で常駐させるゆえ、その機は Casper 専用に張り付く。
# 2026-08-03 z8a(.119) → 新機(.139) へ移設。移設前に7点実測で確認済:
#   到達/モデル2種/推論(冷51s→温0.9s)/常駐VRAM17.3GB/埋込1024次元。
# ★2026-08-18 07:00 .139 が停止(8/10に続き二度目)。z8a(.119)へ一時退避する。
#   退避時の実測: 生成 HTTP200/77.6秒(num_ctx32768・format:json)、埋込 HTTP200/17.2秒。
#   .139(28〜38秒)より遅いが、起票の timeout=300 には収まる。
#   ★.139 復旧後は下の1行を .139 へ戻すこと(コメントを入れ替えるだけ)。
CASPER_OLLAMA=http://192.168.44.119:11434
# CASPER_OLLAMA=http://192.168.44.139:11434   ← 本来の宛先(復旧したらこちらへ戻す)
CASPER_MODEL=qwen3.6:27b

# ── ①-b 退避先候補(2026-08-24 新設) ───────────────────────────────────
# ★これが無いために、2026-08-24 12:00 に HOME(.139)が電源断で落ちた時、
#   退避機構は「現宛先もHOMEも不通」と申したまま【逃げ先が候補に無く動けなかった】。
#   .119 は同時刻に健在(0.03秒応答・qwen3.6:27b/bge-m3とも在庫あり)であったにも拘らず、である。
#   ACTIVE と HOME の二点しか知らぬ機構は、HOME 自身が死ぬ場合に袋小路へ入る。
# 書式: host:port をカンマ区切り。上から順に生成probeを打ち、最初に緑だったものへ退避する。
# HOME と同じ宛先を書いても構わぬ(重複は機構が飛ばす)。
# ★2026-08-24 殿御下命「z8aは別の作業へ回したゆえ使わぬ」→ 候補から外し、禁足席に置く。
CASPER_ALT_OLLAMA=

# 【殿御下命 2026-08-24】禁足席: 何があっても座らぬ宛先(カンマ区切り host:port)。
# z8a(.119)は別の作業へ回された。機構が勝手に戻れば殿の作業を圧迫する。
# ★27bはそもそもz8aに載らぬ(実測: VRAM 3.27/19.14GB=17%・残83%はCPU)。
#   z8aは元より14bの機であり、27bのために.139へ移設したのが2026-08-03である。
CASPER_FORBIDDEN_SEATS=192.168.44.119:11434

# 【cmd_509第2便】本来の宛先(固定台帳・機構は書き換えない)。CASPER_OLLAMA(現在の実効宛先)が
# これと異なる間は「退避中」とみなし、supervisorが常時この宛先の健全性も監視して自動復帰する。
# ★.139/.119の関係が逆転した場合は運用者がここを書き換えること。
CASPER_HOME_OLLAMA=http://192.168.44.139:11434

# ── ①-c 最下段の座席=雲(殿御裁可2026-08-24・甲) ────────────────────────
# GPUの席(現宛先/HOME/候補)が【一つも緑でない】時だけ、雲(claude_cli/Sonnet)へ自動降段する。
# 雲はLANのGPUに依存せぬ唯一の席——救命艇であって住処ではない。
# ★降段中は社の情報がAnthropicを経由する。出た内容は一件残らず帳簿へ:
#     projects/casper/scripts/casper_cloud_ledger.jsonl (git管理外・0600)
#     確認: cd projects/casper/scripts && python3 casper_cloud_ledger.py report
#           python3 casper_cloud_ledger.py list --days 1
# ★縮退: 雲では道具(MCP)を呼べぬ(機構の先読み注入のみ)／意味検索は埋込機が要るため
#         字面検索へ落ちうる。
# 0 にすると降段しない(全滅時は答えられぬまま待つ)。
# ★殿御裁可 2026-08-24: この形(GPUの席が一つも緑でない時だけ雲)で据え置く。
#   雲を全面禁止にすると、.139 が落ちた日に Casper が【丸ごと消える】(実測: 12:00〜12:07、
#   問いは300秒待たされた末に [error] timed out)。対話だけでなく DM秘書・開門ブリーフィング・
#   気にかけどころ・資料照会——社員の入口が全て止まる。秘匿より重い損と判ずる。
CASPER_CLOUD_FALLBACK=1

# 現在の座席(機構が書き換える。ollama=ローカル推論 / claude_cli=雲)。人手で戻してもよい。
CASPER_BACKEND=claude_cli

# ── ①-d 画像の視認(vision) ─ 殿御裁可 2026-08-24「甲=据え置き」 ────────
# vision は CASPER_VISION(既定 claude_cli=雲/Sonnet)。★平時から雲へ出る唯一の常用経路。
# 「雲をできるだけ使わぬ」御方針の下でも、ここは【据え置く】と裁可された。理由:
#  ① 担うのが最も難しい判断である — 図からの数値・ラベル・傾向の客観抽出、高度資料の
#     キャプション注入。コードの設計意図そのものが「痩せてQwenに核心が届かぬ為、判断を
#     能力ある機構へ寄せ、Qwenには"読み取れた事実"を渡す」。ローカル化はこの診断の巻き戻し。
#  ② VRAMの押し合い — 台帳の実測では qwen3.6:27b が 17.3GB を常駐占有(要件18GB以上)。
#     .139 に vision(7B級6GB/11B級8GB)を同居させれば 27b が退去し、画像1枚ごとに
#     冷間51秒が全対話へ波及する。2026-08-24 に z8a で起きた病(VRAM17%・prefill97秒)を
#     設計として招き入れる形になる。
#  ③ 割に合わぬ — 画像を扱うturnは観測4,285中78件=1.8%。その1.8%の品質を落として
#     残り98.2%に冷間リスクを持ち込むことになる。雲を減らす主戦場は毎turnの本文の方。
# ★再考の条件: .139 復電後、/api/ps でVRAMの余白を【実測】し、かつ帳簿
#   (casper_cloud_ledger: door=claude_cli_vision)で実頻度と送出量を一週間貯めてから、
#   三台目の機(vision専用)を要するかを判ずる。憶測でなく数字で。
# "off" にすれば画像の視認を止められる(その場合、資料理解は文字が取れる資料のみになる)。
# CASPER_VISION=claude_cli   ← 既定ゆえ明示不要。止める時のみ off を書く。

# ── ② 埋込(bge-m3) ────────────────────────────────────────────────────
# 現状は①と同居。VRAM 0.7GB と小さいゆえ、別機へ逃がして①の常駐を楽にする手もある。
# 未指定なら CASPER_OLLAMA を使う(casper_embed.py の既定動作)。
# ★2026-08-18 退避中(上に同じ)。復旧後は .139 へ戻す。
# ★殿御裁可 2026-08-24: 埋込(bge-m3)は z8a を借り続ける。
#   理由(実測): bge-m3 は 0.66GB。27b の 19GB とは桁が二つ違い、z8a の作業を圧迫せぬ。
#   禁足席(CASPER_FORBIDDEN_SEATS)は【生成の席】の話であり、埋込はこれとは別に扱う。
#   止めた場合に失うもの(実測): 語が違うと引けなくなる。「納品形式の取り決め」は
#   字面検索で0件・意味検索で3資料(AGL/Nina PARK/Toyota Museum)。加えて reindex が
#   埋込を飛ばすため、新しく知識化した資料が意味検索に載らなくなる。
CASPER_EMBED_ENDPOINT=http://192.168.44.119:11434
# CASPER_EMBED_ENDPOINT=http://192.168.44.139:11434   ← 本来の宛先
CASPER_EMBED_MODEL=bge-m3

# ── ③ Calendar(左脳・真実源) ─ 移設対象外 ─────────────────────────────
# Casper の事実の源。Nibu 陣の管轄。
CASPER_CALENDAR=http://192.168.44.253:8001

# ── ④ Aurora(共有図書館) ─ 移設対象外 ─────────────────────────────────
# ★IPが変動する。casper_aurora.py の自己修復リゾルバが追従し
#   ~/.config/casper/aurora_ip に控える。ここでは固定せぬ(固定すると追従が壊れる)。
#   2026-08-03 時点の実IP: 192.168.44.152 (nina_notepc_02:8100)

# ── ⑤ Casper 自身の待受 ─ 移設対象外(このWSL機) ───────────────────────
CASPER_PORT=8770
CASPER_HTTPS_PORT=8443
# 携帯からの入口: https://192.168.44.45:8443 (Windows portproxy 経由)
